# Alibaba Cloud Bailian (DashScope) API
DASHSCOPE_API_KEY=sk-your-api-key-here

# Database (SQLite file path relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///data/app.db

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma

# Upload Directory
UPLOAD_DIR=uploads

# JWT
JWT_SECRET_KEY=<generate-with-openssl-rand-hex-64>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20

# Model Configuration (DashScope/Bailian)
LLM_MODEL_PRIMARY=qwen-plus
LLM_MODEL_LIGHT=qwen-turbo
LLM_MODEL_HEAVY=qwen-max
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Optional: Redis (leave empty to use in-memory cache)
REDIS_URL=
